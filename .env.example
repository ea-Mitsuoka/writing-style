# Environment variables — copy to .env for local development (never commit .env; GR-001).
# Every variable the application reads MUST be listed here with a dummy value and a
# one-line comment (ARC-010). Deployed environments use the platform secret manager.

# Root of the memory vault checkout (ea-Mitsuoka/ai-memory). Read by `make rules-validate`
# / `src.modules.rules.interface.cli` when --vault is not passed; nothing is written there.
# Set it in your shell profile (zsh: ~/.zshenv so non-interactive shells see it).
OBSIDIAN_VAULT_PATH=/Users/CHANGE_ME/ai-memory
